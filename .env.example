# Database Connection URL (PostgreSQL on host server or managed database)
DATABASE_URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/workflow

# Redis Cache URL
REDIS_URL=redis://127.0.0.1:6379/0

# Security & Secrets
JWT_SECRET=your_production_secure_random_jwt_secret_key_here
MAILTRAP_API_TOKEN=your_mailtrap_api_token_here
SENDER_EMAIL=no-reply@codernex.dev
SENDER_NAME="Agentic Workflow Team"

# AI Service Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
SUPERMEMORY_API_KEY=your_supermemory_api_key_here

# Frontend Base URL (Production API Domain)
NEXT_PUBLIC_BASE_URL=https://api-workflow.codernex.dev/api/v1
