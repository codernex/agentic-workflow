{
  "name": "@repo/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-ts && node -e \"fs.appendFileSync('src/index.ts', '\\nexport { client } from \\'./client.gen\\';\\nexport * from \\'./@tanstack/react-query.gen\\';\\n')\"",
    "build": "openapi-ts && node -e \"fs.appendFileSync('src/index.ts', '\\nexport { client } from \\'./client.gen\\';\\nexport * from \\'./@tanstack/react-query.gen\\';\\n')\""

  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@tanstack/react-query": "^5.101.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "typescript": "^5.7.0"
  }
}
