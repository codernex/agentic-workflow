{
  "name": "agentic-workflow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev:frontend": "pnpm --filter web dev",
    "dev:backend": "cd apps/engine && PYTHONPATH=src .venv/bin/uvicorn main:app --reload --port 8000",

    "generate:api": "cd apps/engine && PYTHONPATH=src .venv/bin/python -c \"import json; from main import app; print(json.dumps(app.openapi(), indent=2))\" > ../../packages/api-client/openapi.json && pnpm --filter @repo/api-client build",



    "generate": "pnpm generate:api",
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "concurrently": "^10.0.4"
  }
}
